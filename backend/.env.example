# ── DECINT backend config ──
# Copy to `.env` and adjust. Everything has a safe default for a solo WSL box.

# HTTP server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OPERATOR_TOKEN is now break-glass ONLY: it works while the users table is
# empty, so a fresh deployment can sign in and create the first admin. The
# moment any account exists this login path closes permanently.
OPERATOR_TOKEN=
SESSION_SECRET=dev-insecure-change-me
# Set true once you're behind TLS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Optional: create an admin automatically on first startup, only when there are
# no accounts at all. Delete both lines once the account exists — or skip this
# and use the CLI instead:  python -m app.cli create-admin --email you@you.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_TTL_SECONDS=600
# Offer login-token sign-in (a per-account bearer credential) on the login page,
# alongside email + password. Issue tokens with:
#   python tools/accounts.py token-create --email client@example.com --label "Acme"
LOGIN_TOKEN_ENABLED=true

# ── Public signup ──
SIGNUP_ENABLED=true
# New accounts land on the free tier and buy up from there. Setting this to a
# paid tier hands every signup that plan for nothing.
SIGNUP_DEFAULT_TIER=free
# "active" lets people in immediately; "pending" holds them for manual approval.
SIGNUP_DEFAULT_STATUS=active
# With SIGNUP_DEFAULT_STATUS=pending: email every new account a link that
# activates it, so nobody waits on an operator — proof of the mailbox stands in
# for the approval. Needs SMTP_* set; without a relay accounts stay pending for
# manual approval as before. The link works for SIGNUP_ACTIVATION_TTL_HOURS.
SIGNUP_EMAIL_ACTIVATION=false
SIGNUP_ACTIVATION_TTL_HOURS=48
SIGNUP_MAX_PER_IP_PER_HOUR=5

# ── hCaptcha (the provider Discord uses) ──
# Free keys at hcaptcha.com. BOTH must be set or captcha is disabled entirely.
# When set, signup always requires a solved captcha and login demands one once
# an IP has failed CAPTCHA_LOGIN_THRESHOLD times inside CAPTCHA_WINDOW_SECONDS.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
CAPTCHA_LOGIN_THRESHOLD=3
CAPTCHA_WINDOW_SECONDS=900
CAPTCHA_ALWAYS_ON_LOGIN=false

# ── Email ──
# Drives four things: the email second factor, the signup notice, the account-
# approved notice, and password-reset links. SMTP_HOST and SMTP_FROM must BOTH
# be set or the whole lot stays switched off — the email 2FA option is hidden
# rather than offered and then failing, and "Forgot password?" does not appear
# on the login page.
#
# Sending as noreply@ your own domain needs a relay that is allowed to. Resend
# (free tier, 3k/month) is the shortest path:
#   1. resend.com ▸ add the domain ▸ copy the DKIM/SPF records to your DNS
#   2. API Keys ▸ create one ▸ paste it as SMTP_PASSWORD below
#   3. python tools/accounts.py mail-test --to you@example.com
# Mailgun/SendGrid/SES work identically — only host, user and password differ.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@decint.tools
SMTP_FROM_NAME=DECINT
SMTP_STARTTLS=true
SMTP_SSL=false

# Where "new signup" alerts land. Comma-separated; blank means every admin
# account's own address. EMAIL_NOTIFICATIONS=false silences those alerts only —
# sign-in codes, approval notices and reset links are always sent.
ADMIN_ALERT_EMAIL=
EMAIL_NOTIFICATIONS=true

# Password reset links: how long one is valid, and how many one IP may ask for
# per hour. Links are single-use and are invalidated by requesting another.
# PUBLIC_BASE_URL (further down) is what the link is built from — without it
# the emailed link is a bare path and useless, so set it before enabling this.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_IP_PER_HOUR=5

# ── SMS second factor (Twilio) ──
# Same fail-closed behaviour. Note SMS is the weakest of the three factors —
# SIM-swap defeats it — so prefer the authenticator app where you can.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Tor (already running in WSL: `systemctl is-active tor`)
TOR_HOST=127.0.0.1
TOR_PORT=9050

# Packet sniffer — admin-only, captures THIS host's traffic, needs root.
# true on your local WSL box; MUST be false on the public server.
SNIFFER_ENABLED=true
SNIFFER_IFACE=

# Discord OSINT. Optional — without it only snowflake decode works.
DISCORD_BOT_TOKEN=

# ── Social login (GitHub / Google OAuth) — CURRENTLY DISABLED ──
# The OAuth code ships but is not wired into the app (see the note in
# app/main.py); the login page offers email + login tokens only. These keys do
# nothing until you re-register the oauth router. Left here for when you do.
#
# PUBLIC_BASE_URL is the origin visitors reach the site on. It is REQUIRED for
# OAuth — the redirect URI registered with each provider is built from it and
# must match exactly. Leave a provider's two keys empty to hide its button.
#
# Register the callback URL at each provider:
#   GitHub  Settings ▸ Developer settings ▸ OAuth Apps ▸ New OAuth App
#           Authorization callback URL:
#             https://decint.tools/api/v1/auth/oauth/github/callback
#   Google  Cloud Console ▸ APIs & Services ▸ Credentials ▸ OAuth client ID
#           Authorized redirect URI:
#             https://decint.tools/api/v1/auth/oauth/google/callback
PUBLIC_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Billing ─────────────────────────────────────────────────────────────────
# Two rails, one entitlement. Cards recur; crypto cannot — nothing on-chain
# lets a merchant pull a renewal — so the crypto rail sells a PREPAID period
# and the UI says so. Both write to the same `entitlements` table, and
# `users.tier` is kept in step, so every existing feature gate is unchanged.
#
# PUBLIC_BASE_URL (set above) is REQUIRED for either rail: checkout return URLs
# and webhook URLs are built from it. Neither rail is offered until it is.
BILLING_ENABLED=true
BILLING_CURRENCY=usd
# Days of paid access after expiry before the sweep drops the account to free.
# Covers a card retry cycle and a slow on-chain confirmation.
BILLING_GRACE_DAYS=3
# Days before a PREPAID period ends to email the customer. Card subscriptions
# renew themselves and are never warned. 0 disables the reminder.
BILLING_EXPIRY_NOTICE_DAYS=7

# ── Stripe (cards, wallets, and the local methods Checkout enables) ──
# Checkout is hosted by Stripe: no card number ever reaches this server, which
# is what keeps the deployment in PCI SAQ-A.
#
#   1. dashboard.stripe.com ▸ Developers ▸ API keys ▸ copy the secret key
#   2. Developers ▸ Webhooks ▸ Add endpoint
#        URL:    https://YOURDOMAIN/api/v1/billing/webhook/stripe
#        Events: checkout.session.completed
#                customer.subscription.created
#                customer.subscription.updated
#                customer.subscription.deleted
#                invoice.paid
#                invoice.payment_failed
#      ▸ copy the signing secret into STRIPE_WEBHOOK_SECRET
#   3. Test it end to end with:  stripe listen --forward-to \
#        localhost:8000/api/v1/billing/webhook/stripe
#
# With STRIPE_WEBHOOK_SECRET empty, every webhook is REJECTED. That is
# deliberate: an unverified billing webhook is an anonymous endpoint for
# granting yourself a paid plan.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Create Products/Prices in the Stripe dashboard matching the amounts
# in backend/app/services/billing/plans.py and paste the price_... ids here.
# Without them checkout still works (prices are built inline), but Stripe's
# customer portal can only offer cancellation, not a plan switch.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_SEMIANNUAL=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SEMIANNUAL=
STRIPE_PRICE_PRO_YEARLY=

# Let Stripe collect and remit VAT/sales tax. Needs Stripe Tax switched on and
# your origin address set in the dashboard first.
STRIPE_TAX_ENABLED=false

# ── NOWPayments (BTC + ~300 other assets) ──
# Coinbase Commerce is NOT an option: it dropped Bitcoin and every other UTXO
# coin in Feb 2024 and closed its merchant portal on 31 March 2026.
#
#   1. nowpayments.io ▸ sign up ▸ set your payout wallet (the address your
#      settlements land in — nothing works until this is set)
#   2. Settings ▸ API keys ▸ create one ▸ NOWPAYMENTS_API_KEY
#   3. Settings ▸ Payments ▸ IPN ▸ generate the secret ▸ NOWPAYMENTS_IPN_SECRET
#        callback URL: https://YOURDOMAIN/api/v1/billing/webhook/nowpayments
#   4. Check both ends with:  GET /api/v1/billing/admin/status  (admin session)
#
# Same fail-closed rule as Stripe: with the IPN secret empty, every callback is
# rejected rather than trusted.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Coins offered at checkout, comma-separated, first is the default. Intersected
# with what your account actually supports. Empty = let the customer pick from
# everything the gateway offers.
NOWPAYMENTS_CURRENCIES=btc,eth,usdttrc20,usdc,ltc,xmr
# Settle every payment into one asset (e.g. usdttrc20) instead of holding each
# coin as itself. Empty keeps each coin as sent.
NOWPAYMENTS_PAYOUT_CURRENCY=

# Leak providers (free, no key). Comma-separated; order is cosmetic.
LEAKS_PROVIDERS=xposedornot,proxynova,leakcheck,hibp_catalog

# ── Visitor analytics ──
ANALYTICS_ENABLED=true
ANALYTICS_DB=data/analytics.db

# Optional MaxMind GeoLite2 files (free account at maxmind.com). Drop
# GeoLite2-City.mmdb and GeoLite2-ASN.mmdb in this directory to resolve
# country/city/ASN. Without them everything still works, geo columns are null.
# Lookups are local — no visitor IP is ever sent to a third party.
GEOIP_DIR=data/geoip

# How much of each visitor's IP to keep:
#   full | anonymized (last octet zeroed) | none (salted hash only)
# `full` is the most useful and is personal data under GDPR. If you serve EU
# visitors, `anonymized` is the setting that keeps city/network accuracy while
# substantially lowering what you're holding.
ANALYTICS_IP_MODE=full

# rotating   — visitor id re-salts daily. Accurate unique counts, but a visitor
#              cannot be linked from one day to the next.
# persistent — stable id across days. This is cross-session tracking of
#              identifiable people; in the EU that needs consent, not just a
#              privacy-policy mention.
ANALYTICS_ID_MODE=rotating

# Store crawler hits (flagged is_bot=1 and hidden from default queries).
ANALYTICS_TRACK_BOTS=true

# Rows older than this are deleted on startup. 0 disables pruning.
ANALYTICS_RETENTION_DAYS=90
