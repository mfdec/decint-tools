<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificate authorities only. A debug build overrides
     this (src/debug) to reach a dev server on the emulator's host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
