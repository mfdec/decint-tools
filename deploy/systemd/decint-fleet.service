# DECINT Fleet hub — runs commands across enrolled servers over SSH.
# Install: sudo cp deploy/systemd/decint-fleet.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now decint-fleet
#
# Runs as its own `fleet` user, NOT as `decint`. The hub holds an SSH key that
# reaches every enrolled server, so it is deliberately kept out of reach of the
# web application's user. The console talks to it only through the backend's
# /api/v1/fleet routes, which are gated by require_admin.
#
# Bound to loopback on purpose — nginx must never proxy port 7070.
[Unit]
Description=DECINT Fleet hub
After=network.target

[Service]
Type=simple
User=fleet
WorkingDirectory=/opt/fleet
Environment=FLEET_BIND=127.0.0.1
Environment=FLEET_PORT=7070
ExecStart=/usr/bin/node /opt/fleet/server.js
Restart=on-failure
RestartSec=3
# Hardening. The hub needs its own data dir (SSH key, inventory, history) and
# nothing else on the filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fleet
PrivateTmp=true

[Install]
WantedBy=multi-user.target
